APP_ENV=development
APP_NAME=Taste Report API
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173

# 비밀키는 프론트엔드가 아닌 이 파일을 복사한 backend/.env에만 입력하세요.
OPENAI_API_KEY=

# Wikimedia 정책에 맞게 배포 주소 또는 연락 가능한 주소를 포함하세요.
WIKIMEDIA_USER_AGENT=TasteReport/0.1 (https://your-project.example)

# 외부 카탈로그 요청 설정
CATALOG_TIMEOUT_SECONDS=8
CATALOG_MAX_RETRIES=1

